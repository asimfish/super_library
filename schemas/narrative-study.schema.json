{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paragraph-level experimental narrative calibration",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","id","as_of","method","scope","artifacts","annotations","normalized_entry_ids","guide_ids","limitations"],
  "properties": {
    "schema_version": {"enum":["1.0"]},
    "id": {"type":"string","minLength":4},
    "as_of": {"type":"string","pattern":"^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "method": {"type":"string","minLength":40,"maxLength":1000},
    "scope": {"type":"string","minLength":20,"maxLength":500},
    "artifacts": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["source_id","pdf_url","sha256"],
        "properties": {
          "source_id":{"type":"string"},
          "pdf_url":{"type":"string","pattern":"^https://"},
          "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
        }
      }
    },
    "annotations": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","source_id","domain","locator","structure","observation","numeric_role","transfer_rule","boundary"],
        "properties": {
          "id":{"type":"string","minLength":4},
          "source_id":{"type":"string"},
          "domain":{"type":"string"},
          "locator":{"type":"string","minLength":10,"maxLength":240},
          "structure":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","maxLength":80}},
          "observation":{"type":"string","minLength":20,"maxLength":500},
          "numeric_role":{"type":"string","minLength":10,"maxLength":350},
          "transfer_rule":{"type":"string","minLength":10,"maxLength":350},
          "boundary":{"type":"string","minLength":10,"maxLength":350}
        }
      }
    },
    "normalized_entry_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "guide_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "limitations":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":20,"maxLength":500}}
  }
}
