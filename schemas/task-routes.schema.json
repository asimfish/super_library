{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Super Library bounded task routes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "max_chars", "routes"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "max_chars": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 24000
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "domain",
          "section",
          "intent",
          "aliases",
          "entry_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "domain": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "guide_id": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          },
          "entry_ids": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
