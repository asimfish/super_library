{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Super Library corpus analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection",
    "audited_at",
    "paper_metadata_records",
    "official_urls_reachable",
    "official_abstracts_analyzed",
    "abstracts_not_analyzed",
    "analysis_policy",
    "promoted_collocation_ids",
    "deduplication"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "collection": {"type": "string", "minLength": 3},
    "audited_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "paper_metadata_records": {"type": "integer", "minimum": 1},
    "official_urls_reachable": {"type": "integer", "minimum": 0},
    "official_abstracts_analyzed": {"type": "integer", "minimum": 0},
    "abstracts_not_analyzed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "venue", "reason", "source_ids"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "venue": {"type": "string", "minLength": 2},
        "reason": {"type": "string", "minLength": 12},
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "analysis_policy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 12}
    },
    "promoted_collocation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_title_and_url_duplicates",
        "normalized_expression_duplicates",
        "near_duplicate_threshold",
        "policy"
      ],
      "properties": {
        "paper_title_and_url_duplicates": {"type": "integer", "minimum": 0},
        "normalized_expression_duplicates": {"type": "integer", "minimum": 0},
        "near_duplicate_threshold": {"type": "number", "minimum": 0},
        "policy": {"type": "string", "minLength": 12}
      }
    }
  }
}
