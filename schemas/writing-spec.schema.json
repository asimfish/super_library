{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI research writing specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "reviewed_at",
    "relationship",
    "notice",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "id": {
      "enum": ["ai-research-writing"]
    },
    "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "relationship": {
      "enum": ["independent_synthesis"]
    },
    "notice": {
      "type": "string",
      "minLength": 3,
      "maxLength": 600
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "level",
          "sections",
          "summary",
          "rationale",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 5,
            "maxLength": 100
          },
          "level": {
            "enum": [
              "must",
              "prefer"
            ]
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160
            }
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 240
          },
          "rationale": {
            "type": "string",
            "minLength": 3,
            "maxLength": 600
          },
          "check": {
            "type": "string",
            "minLength": 3,
            "maxLength": 600
          },
          "contrast": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "facts",
              "before",
              "after",
              "reason"
            ],
            "properties": {
              "facts": {
                "type": "string",
                "minLength": 3,
                "maxLength": 600
              },
              "before": {
                "type": "string",
                "minLength": 3,
                "maxLength": 600
              },
              "after": {
                "type": "string",
                "minLength": 3,
                "maxLength": 600
              },
              "reason": {
                "type": "string",
                "minLength": 3,
                "maxLength": 600
              }
            }
          }
        }
      }
    }
  }
}
