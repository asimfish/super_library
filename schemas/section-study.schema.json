{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_library/schemas/section-study.schema.json",
  "title": "Super Library section-writing study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "as_of",
    "method",
    "scope",
    "sample_source_ids",
    "counts",
    "observations",
    "limitations"
  ],
  "properties": {
    "id": {"type": "string"},
    "as_of": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "method": {"type": "string", "minLength": 20},
    "scope": {"type": "string", "minLength": 20},
    "sample_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_papers",
        "by_domain",
        "by_venue",
        "by_year",
        "document_level_moves"
      ],
      "properties": {
        "full_papers": {"type": "integer", "minimum": 1},
        "by_domain": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "by_venue": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "by_year": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "document_level_moves": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    }
  }
}
