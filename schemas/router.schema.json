{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_library/schemas/router.schema.json",
  "title": "Super Library generated router",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_version",
    "contract_version",
    "as_of",
    "release_tag",
    "entrypoint",
    "core",
    "load_policy",
    "guides",
    "task_routes",
    "table_templates",
    "catalogs",
    "cards",
    "context_bytes",
    "raw_base"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "corpus_version": {"type": "string"},
    "contract_version": {"type": "string"},
    "as_of": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "release_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entrypoint": {"type": "string", "enum": ["agent-index.md"]},
    "core": {"type": "string", "enum": ["core.md"]},
    "load_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "max_guides", "max_catalogs", "recommended_cards", "avoid_by_default"],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string"}
        },
        "max_guides": {"type": "integer", "minimum": 1, "maximum": 1},
        "max_catalogs": {"type": "integer", "minimum": 1, "maximum": 3},
        "recommended_cards": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "maximum": 12}
          }
        },
        "avoid_by_default": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "guides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "records"],
      "properties": {
        "index": {"type": "string", "enum": ["guides/index.md"]},
        "records": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "task_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "records"],
      "properties": {
        "index": {"type": "string", "enum": ["routes/index.md"]},
        "records": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "table_templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "records"],
      "properties": {
        "index": {"type": "string", "enum": ["templates/tables/index.md"]},
        "records": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "sections", "topics", "jsonl"],
      "properties": {
        "domains": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "sections": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "topics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "jsonl": {"type": "string", "enum": ["catalog.jsonl"]}
      }
    },
    "cards": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "context_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_index",
        "core",
        "guide_index",
        "largest_guide",
        "largest_task_route",
        "largest_catalog",
        "largest_card",
        "average_card",
        "legacy_compact",
        "largest_evidence_map"
      ],
      "properties": {
        "agent_index": {"type": "integer", "minimum": 1},
        "core": {"type": "integer", "minimum": 1},
        "guide_index": {"type": "integer", "minimum": 1},
        "largest_guide": {"type": "integer", "minimum": 1},
        "largest_task_route": {"type": "integer", "minimum": 1, "maximum": 24000},
        "largest_catalog": {"type": "integer", "minimum": 1},
        "largest_card": {"type": "integer", "minimum": 1},
        "average_card": {"type": "integer", "minimum": 1},
        "legacy_compact": {"type": "integer", "minimum": 1},
        "largest_evidence_map": {"type": "integer", "minimum": 1}
      }
    },
    "raw_base": {"type": "string", "pattern": "^https://"}
  }
}
