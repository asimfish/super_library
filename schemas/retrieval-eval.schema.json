{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Super Library deterministic retrieval cases",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "query",
      "domain",
      "section",
      "intent",
      "limit",
      "expected_entry_ids"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "query": {
        "type": "string",
        "minLength": 2,
        "maxLength": 240
      },
      "domain": {"type": "string"},
      "topic": {"type": "string"},
      "section": {"type": "string"},
      "intent": {"type": "string"},
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "expected_entry_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {"type": "string"}
      },
      "expected_guide_id": {"type": "string"},
      "expected_task_pack_id": {"type": "string"}
    }
  }
}
