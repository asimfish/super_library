{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_library/schemas/source.schema.json",
  "title": "Super Library primary source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authors", "venue", "year", "url", "identifiers", "topics", "publication_status", "verified_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "venue": {"type": "string"},
    "year": {"type": "integer", "minimum": 1980, "maximum": 2100},
    "url": {"type": "string", "pattern": "^https://"},
    "identifiers": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "publication_status": {
      "enum": ["published", "accepted", "preprint"]
    },
    "verified_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "authors_truncated": {
      "type": "boolean"
    },
    "version_note": {
      "type": "string",
      "minLength": 8
    }
  }
}
