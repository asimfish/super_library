{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Super Library LaTeX table templates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "guide_id", "file", "requires"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120
          },
          "guide_id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+\\.tex$"
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
